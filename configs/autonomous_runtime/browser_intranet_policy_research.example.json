{
  "schema_version": "autonomous_runtime_scenario_v1",
  "scenario_id": "browser_intranet_policy_research",
  "description": "Offline browser-only policy research scenario using local intranet fixtures.",
  "agents": [
    {
      "agent_id": "research_reader",
      "role": "Local intranet policy researcher",
      "priority": 2
    },
    {
      "agent_id": "research_checker",
      "role": "Local policy verification checker",
      "priority": 1
    }
  ],
  "tasks": [
    {
      "task_id": "reader_01_open_home",
      "description": "Open the local intranet home fixture.",
      "priority": 90,
      "assigned_agent_id": "research_reader"
    },
    {
      "task_id": "reader_02_search_policy",
      "description": "Search fixture pages for policy material.",
      "priority": 80,
      "assigned_agent_id": "research_reader",
      "depends_on": [
        "reader_01_open_home"
      ]
    },
    {
      "task_id": "reader_03_click_policy",
      "description": "Navigate to the policy material via a fixture link.",
      "priority": 70,
      "assigned_agent_id": "research_reader",
      "depends_on": [
        "reader_02_search_policy"
      ]
    },
    {
      "task_id": "reader_04_extract_policy",
      "description": "Extract visible text from the policy page.",
      "priority": 60,
      "assigned_agent_id": "research_reader",
      "depends_on": [
        "reader_03_click_policy"
      ]
    },
    {
      "task_id": "reader_05_snapshot_policy",
      "description": "Create a synthetic snapshot artifact for the policy page.",
      "priority": 50,
      "assigned_agent_id": "research_reader",
      "depends_on": [
        "reader_04_extract_policy"
      ]
    },
    {
      "task_id": "checker_01_open_policy",
      "description": "Open the docs policy route after reader research is complete.",
      "priority": 90,
      "assigned_agent_id": "research_checker",
      "depends_on": [
        "reader_05_snapshot_policy"
      ]
    },
    {
      "task_id": "checker_02_extract_policy",
      "description": "Extract policy verification text.",
      "priority": 80,
      "assigned_agent_id": "research_checker",
      "depends_on": [
        "checker_01_open_policy"
      ]
    },
    {
      "task_id": "checker_03_snapshot_policy",
      "description": "Create a checker snapshot artifact for the policy page.",
      "priority": 70,
      "assigned_agent_id": "research_checker",
      "depends_on": [
        "checker_02_extract_policy"
      ]
    }
  ],
  "virtual_environment": {
    "environment_id": "browser_policy_research_fixture_environment",
    "allowed_resource_namespaces": [
      "browser"
    ],
    "workspace": {
      "workspace_root": "artifacts/autonomous_runtime_workspace/browser_intranet_policy_research",
      "per_agent_workspaces": {
        "research_reader": "artifacts/autonomous_runtime_workspace/browser_intranet_policy_research/research_reader",
        "research_checker": "artifacts/autonomous_runtime_workspace/browser_intranet_policy_research/research_checker"
      },
      "reset_policy": "never"
    },
    "metadata": {
      "offline_fixture_only": true,
      "real_browser_launch": false
    }
  },
  "browser_sessions": [
    {
      "session_id": "reader_policy_session",
      "agent_id": "research_reader",
      "workspace_id": "reader_policy_workspace",
      "environment_id": "browser_policy_research_fixture_environment",
      "allowed_domains": [
        "local.intranet",
        "docs.local",
        "portal.local"
      ],
      "start_url": "https://local.intranet/",
      "fixture_manifest_path": "tests/fixtures/local_intranet/office_site_v1/site_manifest.json"
    },
    {
      "session_id": "checker_policy_session",
      "agent_id": "research_checker",
      "workspace_id": "checker_policy_workspace",
      "environment_id": "browser_policy_research_fixture_environment",
      "allowed_domains": [
        "local.intranet",
        "docs.local",
        "portal.local"
      ],
      "start_url": "https://docs.local/docs/policy",
      "fixture_manifest_path": "tests/fixtures/local_intranet/office_site_v1/site_manifest.json"
    }
  ],
  "scripted_steps": [
    {
      "step_id": "reader_open_home",
      "agent_id": "research_reader",
      "task_id": "reader_01_open_home",
      "browser_session_id": "reader_policy_session",
      "action_name": "browser_open_url",
      "parameters": {
        "url": "https://local.intranet/"
      },
      "expected_text": "Office Intranet"
    },
    {
      "step_id": "reader_search_policy",
      "agent_id": "research_reader",
      "task_id": "reader_02_search_policy",
      "browser_session_id": "reader_policy_session",
      "action_name": "browser_search",
      "parameters": {
        "query": "workspace policy"
      },
      "expected_text": "fixture-backed result"
    },
    {
      "step_id": "reader_click_policy",
      "agent_id": "research_reader",
      "task_id": "reader_03_click_policy",
      "browser_session_id": "reader_policy_session",
      "action_name": "browser_click",
      "parameters": {
        "target_text": "Workspace policy"
      },
      "expected_text": "Allowed activity",
      "expected_url": "https://local.intranet/docs/policy"
    },
    {
      "step_id": "reader_extract_policy",
      "agent_id": "research_reader",
      "task_id": "reader_04_extract_policy",
      "browser_session_id": "reader_policy_session",
      "action_name": "browser_extract_text",
      "parameters": {},
      "expected_text": "Agents may read local fixtures"
    },
    {
      "step_id": "reader_snapshot_policy",
      "agent_id": "research_reader",
      "task_id": "reader_05_snapshot_policy",
      "browser_session_id": "reader_policy_session",
      "action_name": "browser_snapshot",
      "parameters": {},
      "required_artifact_ref": "browser/reader_policy_session/reader_policy_session-snapshot-1.json"
    },
    {
      "step_id": "checker_open_policy",
      "agent_id": "research_checker",
      "task_id": "checker_01_open_policy",
      "browser_session_id": "checker_policy_session",
      "action_name": "browser_open_url",
      "parameters": {
        "url": "https://docs.local/docs/policy"
      },
      "expected_text": "Disallowed activity"
    },
    {
      "step_id": "checker_extract_policy",
      "agent_id": "research_checker",
      "task_id": "checker_02_extract_policy",
      "browser_session_id": "checker_policy_session",
      "action_name": "browser_extract_text",
      "parameters": {},
      "expected_text": "private local paths"
    },
    {
      "step_id": "checker_snapshot_policy",
      "agent_id": "research_checker",
      "task_id": "checker_03_snapshot_policy",
      "browser_session_id": "checker_policy_session",
      "action_name": "browser_snapshot",
      "parameters": {},
      "required_artifact_ref": "browser/checker_policy_session/checker_policy_session-snapshot-1.json"
    }
  ],
  "runtime_policy": {
    "scheduler": "round_robin",
    "max_ticks": 35,
    "max_actions_total": 30,
    "max_actions_per_agent": 15,
    "idle_tick_limit": 10,
    "max_failures_total": 2,
    "max_retries_per_task": 0,
    "max_agent_failures": 2,
    "stop_when_all_tasks_terminal": true,
    "stop_when_no_runnable_agents": true
  },
  "expected_results": [
    {
      "result_id": "reader_policy_text",
      "kind": "task_browser_expected_result",
      "task_id": "reader_04_extract_policy",
      "expected_text": "Agents may read local fixtures",
      "expected_current_url": "https://local.intranet/docs/policy"
    },
    {
      "result_id": "reader_policy_snapshot",
      "kind": "task_browser_expected_result",
      "task_id": "reader_05_snapshot_policy",
      "expected_snapshot_count_min": 1,
      "expected_artifact_kinds": [
        "browser_snapshot"
      ]
    },
    {
      "result_id": "checker_policy_url",
      "kind": "task_browser_expected_result",
      "task_id": "checker_01_open_policy",
      "expected_text": "Disallowed activity",
      "expected_current_url": "https://docs.local/docs/policy"
    },
    {
      "result_id": "checker_policy_snapshot",
      "kind": "task_browser_expected_result",
      "task_id": "checker_03_snapshot_policy",
      "expected_snapshot_count_min": 1,
      "expected_artifact_kinds": [
        "browser_snapshot"
      ]
    }
  ],
  "validation_warnings": [
    "fixture_backed_browser_runtime_only",
    "no_real_browser_or_external_network"
  ]
}
