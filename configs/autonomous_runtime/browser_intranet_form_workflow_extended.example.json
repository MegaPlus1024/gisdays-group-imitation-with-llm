{
  "schema_version": "autonomous_runtime_scenario_v1",
  "scenario_id": "browser_intranet_form_workflow_extended",
  "description": "Offline browser-only scenario covering navigation, form fill/submit, wait, snapshots, and task dependencies.",
  "agents": [
    {
      "agent_id": "research_reader",
      "role": "Local intranet navigation reader",
      "priority": 3
    },
    {
      "agent_id": "policy_checker",
      "role": "Local policy checker",
      "priority": 2
    },
    {
      "agent_id": "portal_operator",
      "role": "Local portal form operator",
      "priority": 1
    }
  ],
  "tasks": [
    {
      "task_id": "reader_01_open_home",
      "description": "Open the local intranet fixture home page.",
      "priority": 80,
      "assigned_agent_id": "research_reader"
    },
    {
      "task_id": "reader_02_click_ticket_board",
      "description": "Navigate to the ticket board by clicking a fixture link.",
      "priority": 70,
      "assigned_agent_id": "research_reader",
      "depends_on": [
        "reader_01_open_home"
      ]
    },
    {
      "task_id": "reader_03_snapshot_ticket_board",
      "description": "Create a synthetic snapshot artifact for the ticket board.",
      "priority": 60,
      "assigned_agent_id": "research_reader",
      "depends_on": [
        "reader_02_click_ticket_board"
      ]
    },
    {
      "task_id": "checker_01_open_policy",
      "description": "Open the workspace policy fixture.",
      "priority": 80,
      "assigned_agent_id": "policy_checker"
    },
    {
      "task_id": "checker_02_wait_on_policy",
      "description": "Run a deterministic synthetic wait on the policy page.",
      "priority": 70,
      "assigned_agent_id": "policy_checker",
      "depends_on": [
        "checker_01_open_policy"
      ]
    },
    {
      "task_id": "portal_01_open_request_form",
      "description": "Open the local portal request form after ticket context is available.",
      "priority": 80,
      "assigned_agent_id": "portal_operator",
      "depends_on": [
        "reader_02_click_ticket_board"
      ]
    },
    {
      "task_id": "portal_02_fill_request_form",
      "description": "Fill a synthetic local form state.",
      "priority": 70,
      "assigned_agent_id": "portal_operator",
      "depends_on": [
        "portal_01_open_request_form"
      ]
    },
    {
      "task_id": "portal_03_submit_request_form",
      "description": "Submit the synthetic form and navigate to the fixture confirmation page.",
      "priority": 60,
      "assigned_agent_id": "portal_operator",
      "depends_on": [
        "portal_02_fill_request_form"
      ]
    }
  ],
  "virtual_environment": {
    "environment_id": "browser_intranet_extended_fixture_environment",
    "allowed_resource_namespaces": [
      "browser"
    ],
    "workspace": {
      "workspace_root": "artifacts/autonomous_runtime_workspace/browser_intranet_form_workflow_extended",
      "per_agent_workspaces": {
        "research_reader": "artifacts/autonomous_runtime_workspace/browser_intranet_form_workflow_extended/research_reader",
        "policy_checker": "artifacts/autonomous_runtime_workspace/browser_intranet_form_workflow_extended/policy_checker",
        "portal_operator": "artifacts/autonomous_runtime_workspace/browser_intranet_form_workflow_extended/portal_operator"
      },
      "reset_policy": "never"
    },
    "metadata": {
      "offline_fixture_only": true,
      "real_browser_launch": false
    }
  },
  "browser_sessions": [
    {
      "session_id": "reader_session",
      "agent_id": "research_reader",
      "workspace_id": "reader_browser_workspace",
      "environment_id": "browser_intranet_extended_fixture_environment",
      "allowed_domains": [
        "local-intranet.test",
        "localhost",
        "127.0.0.1"
      ],
      "start_url": "https://local-intranet.test/",
      "fixture_manifest_path": "tests/fixtures/local_intranet/office_site_v1/site_manifest.json"
    },
    {
      "session_id": "checker_session",
      "agent_id": "policy_checker",
      "workspace_id": "checker_browser_workspace",
      "environment_id": "browser_intranet_extended_fixture_environment",
      "allowed_domains": [
        "local-intranet.test",
        "localhost",
        "127.0.0.1"
      ],
      "start_url": "https://local-intranet.test/docs/policy",
      "fixture_manifest_path": "tests/fixtures/local_intranet/office_site_v1/site_manifest.json"
    },
    {
      "session_id": "portal_session",
      "agent_id": "portal_operator",
      "workspace_id": "portal_browser_workspace",
      "environment_id": "browser_intranet_extended_fixture_environment",
      "allowed_domains": [
        "local-intranet.test",
        "localhost",
        "127.0.0.1"
      ],
      "start_url": "https://local-intranet.test/portal/request",
      "fixture_manifest_path": "tests/fixtures/local_intranet/office_site_v1/site_manifest.json"
    }
  ],
  "scripted_steps": [
    {
      "step_id": "reader_open_home",
      "agent_id": "research_reader",
      "task_id": "reader_01_open_home",
      "browser_session_id": "reader_session",
      "action_name": "browser_open_url",
      "parameters": {
        "url": "https://local-intranet.test/"
      },
      "expected_text": "Office Intranet"
    },
    {
      "step_id": "reader_click_ticket_board",
      "agent_id": "research_reader",
      "task_id": "reader_02_click_ticket_board",
      "browser_session_id": "reader_session",
      "action_name": "browser_click",
      "parameters": {
        "target_text": "Ticket board"
      },
      "expected_text": "Quarterly Access Review",
      "expected_url": "https://local-intranet.test/tickets"
    },
    {
      "step_id": "reader_snapshot_ticket_board",
      "agent_id": "research_reader",
      "task_id": "reader_03_snapshot_ticket_board",
      "browser_session_id": "reader_session",
      "action_name": "browser_snapshot",
      "parameters": {},
      "required_artifact_ref": "browser/reader_session/reader_session-snapshot-1.json"
    },
    {
      "step_id": "checker_open_policy",
      "agent_id": "policy_checker",
      "task_id": "checker_01_open_policy",
      "browser_session_id": "checker_session",
      "action_name": "browser_open_url",
      "parameters": {
        "url": "https://local-intranet.test/docs/policy"
      },
      "expected_text": "Allowed activity"
    },
    {
      "step_id": "checker_wait_policy",
      "agent_id": "policy_checker",
      "task_id": "checker_02_wait_on_policy",
      "browser_session_id": "checker_session",
      "action_name": "browser_wait",
      "parameters": {
        "milliseconds": 250
      },
      "expected_text": "Fixture browser wait completed"
    },
    {
      "step_id": "portal_open_request_form",
      "agent_id": "portal_operator",
      "task_id": "portal_01_open_request_form",
      "browser_session_id": "portal_session",
      "action_name": "browser_open_url",
      "parameters": {
        "url": "https://local-intranet.test/portal/request"
      },
      "expected_text": "Portal Request Form"
    },
    {
      "step_id": "portal_fill_request_form",
      "agent_id": "portal_operator",
      "task_id": "portal_02_fill_request_form",
      "browser_session_id": "portal_session",
      "action_name": "browser_fill",
      "parameters": {
        "form_id": "local-request",
        "fields": {
          "owner": "office",
          "status": "ready"
        }
      },
      "expected_text": "Updated 2 fixture form field"
    },
    {
      "step_id": "portal_submit_request_form",
      "agent_id": "portal_operator",
      "task_id": "portal_03_submit_request_form",
      "browser_session_id": "portal_session",
      "action_name": "browser_submit",
      "parameters": {
        "form_id": "local-request",
        "success_url": "https://local-intranet.test/portal/submitted"
      },
      "expected_text": "Local portal request submitted",
      "expected_url": "https://local-intranet.test/portal/submitted"
    }
  ],
  "runtime_policy": {
    "scheduler": "round_robin",
    "max_ticks": 30,
    "max_actions_total": 30,
    "max_actions_per_agent": 12,
    "idle_tick_limit": 8,
    "max_failures_total": 2,
    "max_retries_per_task": 0,
    "max_agent_failures": 2,
    "stop_when_all_tasks_terminal": true,
    "stop_when_no_runnable_agents": true
  },
  "expected_results": [
    {
      "result_id": "reader_click_reached_ticket_board",
      "kind": "task_browser_expected_result",
      "task_id": "reader_02_click_ticket_board",
      "expected_text": "Quarterly Access Review",
      "expected_current_url": "https://local-intranet.test/tickets"
    },
    {
      "result_id": "reader_snapshot_artifact",
      "kind": "task_browser_expected_result",
      "task_id": "reader_03_snapshot_ticket_board",
      "expected_snapshot_count_min": 1,
      "expected_artifact_kinds": [
        "browser_snapshot"
      ]
    },
    {
      "result_id": "checker_wait_completed",
      "kind": "task_browser_expected_result",
      "task_id": "checker_02_wait_on_policy",
      "expected_text": "Fixture browser wait completed",
      "expected_current_url": "https://local-intranet.test/docs/policy"
    },
    {
      "result_id": "portal_form_submitted",
      "kind": "task_browser_expected_result",
      "task_id": "portal_03_submit_request_form",
      "expected_text": "Local portal request submitted",
      "expected_current_url": "https://local-intranet.test/portal/submitted"
    },
    {
      "result_id": "portal_session_current_url",
      "kind": "browser_session_current_url",
      "session_id": "portal_session",
      "expected_url": "https://local-intranet.test/portal/submitted"
    }
  ],
  "validation_warnings": [
    "fixture_backed_browser_runtime_only",
    "no_real_browser_or_external_network"
  ]
}
