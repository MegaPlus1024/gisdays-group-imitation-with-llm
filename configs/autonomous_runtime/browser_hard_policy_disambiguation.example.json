{
  "schema_version": "autonomous_runtime_scenario_v1",
  "scenario_id": "hard_policy_disambiguation",
  "description": "Offline browser-only policy disambiguation using local fixtures.",
  "agents": [
    {
      "agent_id": "policy_reader",
      "role": "Local policy disambiguation reviewer",
      "priority": 1
    }
  ],
  "tasks": [
    {
      "task_id": "policy_01_open_disambiguation",
      "description": "Open the policy disambiguation fixture.",
      "priority": 80,
      "assigned_agent_id": "policy_reader"
    },
    {
      "task_id": "policy_02_click_current",
      "description": "Choose the current policy source instead of the archive copy.",
      "priority": 70,
      "assigned_agent_id": "policy_reader",
      "depends_on": [
        "policy_01_open_disambiguation"
      ]
    },
    {
      "task_id": "policy_03_extract_current",
      "description": "Extract the active policy text from the current policy fixture.",
      "priority": 60,
      "assigned_agent_id": "policy_reader",
      "depends_on": [
        "policy_02_click_current"
      ]
    },
    {
      "task_id": "policy_04_snapshot_current",
      "description": "Create a synthetic snapshot artifact for the current policy page.",
      "priority": 50,
      "assigned_agent_id": "policy_reader",
      "depends_on": [
        "policy_03_extract_current"
      ]
    }
  ],
  "virtual_environment": {
    "environment_id": "browser_hard_policy_disambiguation_fixture_environment",
    "allowed_resource_namespaces": [
      "browser"
    ],
    "workspace": {
      "workspace_root": "artifacts/autonomous_runtime_workspace/browser_hard_policy_disambiguation",
      "per_agent_workspaces": {
        "policy_reader": "artifacts/autonomous_runtime_workspace/browser_hard_policy_disambiguation/policy_reader"
      },
      "reset_policy": "never"
    },
    "metadata": {
      "offline_fixture_only": true,
      "real_browser_launch": false
    }
  },
  "browser_sessions": [
    {
      "session_id": "policy_session",
      "agent_id": "policy_reader",
      "workspace_id": "policy_session_workspace",
      "environment_id": "browser_hard_policy_disambiguation_fixture_environment",
      "allowed_domains": [
        "local.intranet",
        "docs.local",
        "localhost",
        "127.0.0.1"
      ],
      "start_url": "https://docs.local/docs/policy-disambiguation",
      "fixture_manifest_path": "tests/fixtures/local_intranet/office_site_v1/site_manifest.json"
    }
  ],
  "scripted_steps": [
    {
      "step_id": "open_policy_disambiguation",
      "agent_id": "policy_reader",
      "task_id": "policy_01_open_disambiguation",
      "browser_session_id": "policy_session",
      "action_name": "browser_open_url",
      "parameters": {
        "url": "https://docs.local/docs/policy-disambiguation"
      },
      "expected_text": "Choose the live source"
    },
    {
      "step_id": "click_current_policy",
      "agent_id": "policy_reader",
      "task_id": "policy_02_click_current",
      "browser_session_id": "policy_session",
      "action_name": "browser_click",
      "parameters": {
        "target_text": "Current policy"
      },
      "expected_text": "Workspace Policy",
      "expected_url": "https://docs.local/docs/policy"
    },
    {
      "step_id": "extract_current_policy_text",
      "agent_id": "policy_reader",
      "task_id": "policy_03_extract_current",
      "browser_session_id": "policy_session",
      "action_name": "browser_extract_text",
      "parameters": {},
      "expected_text": "Allowed activity"
    },
    {
      "step_id": "snapshot_current_policy",
      "agent_id": "policy_reader",
      "task_id": "policy_04_snapshot_current",
      "browser_session_id": "policy_session",
      "action_name": "browser_snapshot",
      "parameters": {},
      "required_artifact_ref": "browser/policy_session/policy_session-snapshot-1.json"
    }
  ],
  "runtime_policy": {
    "scheduler": "round_robin",
    "max_ticks": 20,
    "max_actions_total": 10,
    "max_actions_per_agent": 10,
    "idle_tick_limit": 5,
    "max_failures_total": 2,
    "max_retries_per_task": 0,
    "max_agent_failures": 2,
    "stop_when_all_tasks_terminal": true,
    "stop_when_no_runnable_agents": true
  },
  "expected_results": [
    {
      "result_id": "policy_disambiguation_opened",
      "kind": "task_browser_expected_result",
      "task_id": "policy_01_open_disambiguation",
      "expected_text": "Choose the live source",
      "expected_current_url": "https://docs.local/docs/policy-disambiguation"
    },
    {
      "result_id": "policy_current_link_followed",
      "kind": "task_browser_expected_result",
      "task_id": "policy_02_click_current",
      "expected_text": "Workspace Policy",
      "expected_current_url": "https://docs.local/docs/policy"
    },
    {
      "result_id": "policy_current_marker_seen",
      "kind": "task_browser_expected_result",
      "task_id": "policy_03_extract_current",
      "expected_text": "Allowed activity"
    },
    {
      "result_id": "policy_snapshot_recorded",
      "kind": "task_browser_expected_result",
      "task_id": "policy_04_snapshot_current",
      "expected_snapshot_count_min": 1,
      "expected_artifact_kinds": [
        "browser_snapshot"
      ]
    },
    {
      "result_id": "policy_session_url",
      "kind": "browser_session_current_url",
      "session_id": "policy_session",
      "expected_url": "https://docs.local/docs/policy"
    }
  ],
  "validation_warnings": [
    "fixture_backed_browser_runtime_only",
    "no_real_browser_or_external_network"
  ]
}
