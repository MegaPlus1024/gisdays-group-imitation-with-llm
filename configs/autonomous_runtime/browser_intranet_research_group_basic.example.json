{
  "schema_version": "autonomous_runtime_scenario_v1",
  "scenario_id": "browser_intranet_research_group_basic",
  "description": "Offline browser-only autonomous runtime scenario using local HTML fixtures and deterministic scripted decisions.",
  "agents": [
    {
      "agent_id": "research_reader",
      "role": "Local intranet research reader",
      "priority": 2
    },
    {
      "agent_id": "research_checker",
      "role": "Local policy checker",
      "priority": 1
    }
  ],
  "tasks": [
    {
      "task_id": "reader_01_open_ticket",
      "description": "Open the local intranet ticket fixture.",
      "priority": 60,
      "assigned_agent_id": "research_reader"
    },
    {
      "task_id": "reader_02_extract_ticket",
      "description": "Extract ticket text from the fixture-backed page.",
      "priority": 50,
      "assigned_agent_id": "research_reader"
    },
    {
      "task_id": "reader_03_snapshot_ticket",
      "description": "Create a synthetic snapshot artifact for the ticket page.",
      "priority": 40,
      "assigned_agent_id": "research_reader"
    },
    {
      "task_id": "checker_01_open_policy",
      "description": "Open the workspace policy fixture.",
      "priority": 60,
      "assigned_agent_id": "research_checker"
    },
    {
      "task_id": "checker_02_search_policy",
      "description": "Search fixture pages for workspace policy.",
      "priority": 50,
      "assigned_agent_id": "research_checker"
    },
    {
      "task_id": "checker_03_snapshot_policy",
      "description": "Create a synthetic snapshot artifact for the policy page.",
      "priority": 40,
      "assigned_agent_id": "research_checker"
    }
  ],
  "virtual_environment": {
    "environment_id": "browser_intranet_fixture_environment",
    "allowed_resource_namespaces": [
      "browser"
    ],
    "workspace": {
      "workspace_root": "artifacts/autonomous_runtime_workspace/browser_intranet_research_group_basic",
      "per_agent_workspaces": {
        "research_reader": "artifacts/autonomous_runtime_workspace/browser_intranet_research_group_basic/research_reader",
        "research_checker": "artifacts/autonomous_runtime_workspace/browser_intranet_research_group_basic/research_checker"
      },
      "reset_policy": "never"
    },
    "metadata": {
      "offline_fixture_only": true,
      "real_browser_launch": false
    }
  },
  "browser_sessions": [
    {
      "session_id": "reader_session",
      "agent_id": "research_reader",
      "workspace_id": "reader_browser_workspace",
      "environment_id": "browser_intranet_fixture_environment",
      "allowed_domains": [
        "local.intranet",
        "docs.local",
        "portal.local",
        "localhost",
        "127.0.0.1"
      ],
      "start_url": "https://local.intranet/",
      "fixture_manifest_path": "tests/fixtures/local_intranet/office_site_v1/site_manifest.json"
    },
    {
      "session_id": "checker_session",
      "agent_id": "research_checker",
      "workspace_id": "checker_browser_workspace",
      "environment_id": "browser_intranet_fixture_environment",
      "allowed_domains": [
        "local.intranet",
        "docs.local",
        "portal.local",
        "localhost",
        "127.0.0.1"
      ],
      "start_url": "https://docs.local/docs/policy",
      "fixture_manifest_path": "tests/fixtures/local_intranet/office_site_v1/site_manifest.json"
    }
  ],
  "scripted_steps": [
    {
      "step_id": "reader_open_ticket",
      "agent_id": "research_reader",
      "task_id": "reader_01_open_ticket",
      "browser_session_id": "reader_session",
      "action_name": "browser_open_url",
      "parameters": {
        "url": "https://local.intranet/tickets/1"
      },
      "expected_text": "Quarterly Access Review"
    },
    {
      "step_id": "reader_extract_ticket",
      "agent_id": "research_reader",
      "task_id": "reader_02_extract_ticket",
      "browser_session_id": "reader_session",
      "action_name": "browser_extract_text",
      "parameters": {},
      "expected_text": "Expected activity"
    },
    {
      "step_id": "reader_snapshot_ticket",
      "agent_id": "research_reader",
      "task_id": "reader_03_snapshot_ticket",
      "browser_session_id": "reader_session",
      "action_name": "browser_snapshot",
      "parameters": {},
      "required_artifact_ref": "browser/reader_session/reader_session-snapshot-1.json"
    },
    {
      "step_id": "checker_open_policy",
      "agent_id": "research_checker",
      "task_id": "checker_01_open_policy",
      "browser_session_id": "checker_session",
      "action_name": "browser_open_url",
      "parameters": {
        "url": "https://docs.local/docs/policy"
      },
      "expected_text": "Allowed activity"
    },
    {
      "step_id": "checker_search_policy",
      "agent_id": "research_checker",
      "task_id": "checker_02_search_policy",
      "browser_session_id": "checker_session",
      "action_name": "browser_search",
      "parameters": {
        "query": "workspace policy"
      },
      "expected_text": "fixture-backed result"
    },
    {
      "step_id": "checker_snapshot_policy",
      "agent_id": "research_checker",
      "task_id": "checker_03_snapshot_policy",
      "browser_session_id": "checker_session",
      "action_name": "browser_snapshot",
      "parameters": {
        "url": "https://docs.local/docs/policy"
      },
      "required_artifact_ref": "browser/checker_session/checker_session-snapshot-1.json"
    }
  ],
  "runtime_policy": {
    "scheduler": "round_robin",
    "max_ticks": 20,
    "max_actions_total": 20,
    "max_actions_per_agent": 10,
    "idle_tick_limit": 3,
    "max_failures_total": 2,
    "max_retries_per_task": 0,
    "max_agent_failures": 2,
    "stop_when_all_tasks_terminal": true,
    "stop_when_no_runnable_agents": true
  },
  "expected_results": [
    {
      "result_id": "all_reader_open_done",
      "kind": "task_completed",
      "task_id": "reader_01_open_ticket"
    },
    {
      "result_id": "reader_text_seen",
      "kind": "browser_session_text",
      "session_id": "reader_session",
      "expected_text": "Quarterly Access Review"
    },
    {
      "result_id": "checker_policy_url",
      "kind": "browser_session_current_url",
      "session_id": "checker_session",
      "expected_url": "https://docs.local/docs/policy"
    },
    {
      "result_id": "reader_snapshot",
      "kind": "snapshot_count_at_least",
      "session_id": "reader_session",
      "count": 1
    },
    {
      "result_id": "checker_snapshot",
      "kind": "snapshot_count_at_least",
      "session_id": "checker_session",
      "count": 1
    }
  ],
  "validation_warnings": [
    "fixture_backed_browser_runtime_only",
    "no_real_browser_or_external_network"
  ]
}
