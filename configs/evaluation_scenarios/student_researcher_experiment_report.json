{
  "scenario_id": "student_researcher_experiment_report_v1",
  "schema_version": "evaluation_scenario_v1",
  "name": "Student researcher experiment report",
  "description": "Evaluate whether a local model can imitate a student researcher preparing an experiment report.",
  "mode": "single_agent",
  "agents": [
    {
      "agent_id": "researcher_agent_1",
      "role_id": "student_researcher",
      "role_template_path": "configs/roles/student_researcher.example.json",
      "activity_profile_path": "configs/activity_profiles/student_researcher.json",
      "initial_state_path": "configs/agent_state.example.json",
      "available_actions": [
        "read_file",
        "create_file",
        "append_file",
        "list_directory",
        "office_create_document_stub"
      ],
      "expected_action_families": [
        "file",
        "office"
      ],
      "expected_behavior_notes": [
        "Should use history when summarizing findings."
      ]
    }
  ],
  "stop_policy": {
    "max_steps": 5,
    "stop_on_validation_failure": true,
    "stop_on_unsafe_action": true,
    "stop_on_repeated_action": true,
