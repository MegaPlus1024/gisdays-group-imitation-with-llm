    "stop_on_excessive_atypical_actions": true,
    "stop_on_no_progress": false,
    "stop_criteria_config_path": "configs/autonomous_stop_criteria.example.json"
  },
  "metrics": [
    "normal_activity_score",
    "diversity_score",
    "sequence_coherence_score",
    "history_usage_score",
    "repetition_score",
    "average_selection_latency_seconds"
  ],
  "expected_behavior": {
    "min_normal_activity_score": 0.6,
    "min_diversity_score": 0.4,
    "max_repeated_same_parameters": 2,
    "max_forbidden_for_normality_count": 0,
    "max_atypical_action_count": 2,
    "required_sequence_patterns": [
      "inspect_experiment_then_summarize"
    ],
    "forbidden_actions": []
  },
  "resource_plan": {
    "cpu_only": true,
    "collect_latency": true,
    "collect_cpu": true,
    "collect_ram": true,
    "collect_tokens_per_second": true,
    "estimate_multi_agent_capacity": false
  },
  "behavioral_fixture_refs": [
    "tests/fixtures/behavioral_trajectories/trajectories/student_researcher_normal.json",
    "tests/fixtures/behavioral_trajectories/trajectories/student_researcher_incoherent.json",
