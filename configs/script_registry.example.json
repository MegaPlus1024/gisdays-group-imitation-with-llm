    {
      "name": "office_create_docx",
      "description": "Create a DOCX document file through the optional office document-file backend; no desktop office application is opened.",
      "parameters": [
        {
          "name": "path",
          "type": "string",
          "required": true,
          "description": "Relative artifact path for the DOCX file.",
          "min_length": 1
        },
        {
          "name": "title",
          "type": "string",
          "description": "Optional document title.",
          "max_length": 5000
        },
        {
          "name": "paragraphs",
          "type": "array",
          "description": "Optional list of paragraph strings."
        },
        {
          "name": "metadata",
          "type": "object",
          "description": "Optional caller metadata."
        }
      ],
      "safety": {
        "allowed_file_roots": [
          "artifacts/",
          "experiments/",
          "tests/"
        ],
        "forbidden_file_roots": [
          "models/gguf/",
          ".venv/",
          ".git/",
          "logs/",
          "secrets/",
          "credentials/",
          "tokens/"
        ],
        "read_only": false,
        "notes": [
          "Optional document-file automation only.",
          "Backend remains disabled unless explicitly configured."
        ]
      },
      "result_shape": {
        "document_type": "docx",
        "path_relative": "string",
        "text_preview": "string"
      },
      "tags": [
        "office",
        "optional_office",
        "document_file",
        "write"
      ],
      "examples": [
        {
          "path": "artifacts/office/summary.docx",
