  "scripts": [
    {
      "name": "read_file",
      "description": "Read a UTF-8 text file from an allowed project path.",
      "parameters": [
        {
          "name": "path",
          "type": "string",
          "required": true,
          "description": "Relative project path to read.",
          "min_length": 1
        }
      ],
      "safety": {
        "allowed_file_roots": [
          "docs/",
          "configs/",
          "experiments/",
          "src/",
          "tests/"
        ],
        "forbidden_file_roots": [
          "models/gguf/",
          ".venv/",
          ".git/"
        ],
        "read_only": true
      },
      "result_shape": {
        "content": "string",
        "path": "string"
      },
      "tags": [
        "file"
      ],
      "examples": [
        {
          "path": "docs/ai/model_registry.md"
        }
      ]
    },
    {
      "name": "create_file",
      "description": "Create or overwrite a UTF-8 text file in allowed write roots.",
