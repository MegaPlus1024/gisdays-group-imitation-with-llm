{
  "schema_version": "canonical_multi_agent_long_horizon_config_v1",
  "experiment_id": "behavioral_benchmark_v2",
  "scenario_ids": [
    "article_file_handoff_v2",
    "office_shared_fact_recovery_v2",
    "role_boundary_exact_handoff",
    "malformed_action_recovery",
    "conflicting_grounded_facts",
    "dependency_progress_and_finish_guard",
    "long_horizon_multi_fact_retention"
  ],
  "trials_per_scenario": 5,
  "max_turns_per_trial": 40,
  "scheduler": "round_robin",
  "fixture_only": true,
  "model_execution": false,
  "model_profile": {
    "model_id": "third_model",
    "disable_thinking": true,
    "no_think_prefix": "/no_think",
    "response_max_tokens": 512,
    "temperature": 0.0,
    "timeout_seconds": 120.0
  },
  "agents": {
    "source": "canonical_scenario_definitions",
    "minimum_agents": 2
  },
  "output_dir": "artifacts/behavioral_benchmark_v2",
  "metrics": [
    "turns",
    "model_calls",
    "valid_actions",
    "invalid_actions",
    "successful_tools",
    "failed_tools",
    "recovery_successes",
    "repeated_actions",
    "role_violations",
    "scheduler_fairness"
  ],
  "failure_policy": {
    "fail_fast": false,
    "skip_existing": false
  }
}
